{
  "name": "kvideo",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  
  "build": {
    "command": "npm run pages:build"
  },
  
  "main": ".vercel/output/static/_worker.js/index.js",
  
  "assets": {
    "directory": ".vercel/output/static"
  },
  
  "dev": {
    "local_protocol": "http",
    "port": 3000
  },
  
  "vars": {
    "ENVIRONMENT": "production"
  }
}
