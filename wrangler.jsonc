{
  "name": "kvideo",
  "type": "module",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  
  "build": {
    "command": "npm run pages:build",
    "cwd": "./"
  },
  
  "main": ".vercel/output/static/_worker.js/index.js",
  
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
