{
  // 项目基本信息
  "name": "kvideo",
  "type": "service",
  
  // 兼容性设置
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  
  // 构建配置 - 使用 next-on-pages
  "build": {
    "command": "npm run pages:build",
    "cwd": "./",
    "watch_paths": ["src/**", "app/**", "public/**", "next.config.ts"]
  },
  
  // 静态资源配置
  "assets": {
    "directory": ".vercel/output/static",
    "binding": "ASSETS"
  },
  
  // 开发服务器
  "dev": {
    "local_protocol": "http",
    "port": 3000
  },
  
  // 环境变量
  "vars": {
    "ENVIRONMENT": "production"
  },
  
  // 环境配置
  "env": {
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "development": {
      "vars": {
        "ENVIRONMENT": "development"
      }
    }
  }
}
